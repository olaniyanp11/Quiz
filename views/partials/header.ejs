<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quiz App</title>
  <script src="https://cdn.tailwindcss.com"></script>
<!-- Inside your <head> tag -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" integrity="sha512-k6RqeWeci5ZR/Lv4MR0sA0FfDOM1N65QZsXl+2KjreEiXjhIx2sYq+U+eP4yX9Y5M2hZt9Jg7Zx9Yz1T1CqPjw==" crossorigin="anonymous" referrerpolicy="no-referrer" />

</head>
<body class="font-sans">

<nav class="bg-transparent w-full z-50">
  <div class="max-w-7xl mx-auto p-2 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 py-3">
      <div class="flex-shrink-0 text-green-700 font-bold text-2xl">
        QuizApp
      </div>
      <div class="hidden md:flex items-center space-x-6">
        <a href="/" class="hover:text-green-300 <%= user ? 'text-green-700' : 'text-white' %>">Home</a>
        <a href="#how-it-works" class="hover:text-green-300 <%= user ? 'text-green-700' : 'text-white' %>">How It
          Works</a>
        <a href="/leaderboard"
          class="hover:text-green-300 <%= user ? 'text-green-700' : 'text-white' %>">Leaderboard</a>

        <% if(!user){ %>
          <a href="/login" class="bg-green-500 text-white px-4 py-2 rounded hover:bg-green-600">Login</a>
          <a href="/register" class="bg-white text-green-600 px-4 py-2 rounded hover:bg-gray-100">Sign Up</a>
          <% } else { %>
            <% if(user.role==='admin' ){ %>
              <a href="/admin" class="bg-green-500 text-white px-4 py-2 rounded hover:bg-green-600">Admin</a>
              <% } %>
                <a href="/dashboard" class="bg-green-500 text-white px-4 py-2 rounded hover:bg-green-600">Dashboard</a>
                <a href="/logout" class="bg-red-500 text-white px-4 py-2 rounded hover:bg-red-600">Logout</a>
                <% } %>
      </div>
    </div>
  </div>
</nav>


<script>
  // Mobile menu toggle
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn.addEventListener('click', () => menu.classList.toggle('hidden'));
</script>


  <!-- ✅ Flash Messages -->
  <% if (typeof success_msg !== 'undefined' && success_msg.length > 0) { %>
    <div class="fixed top-4 left-1/2 transform -translate-x-1/2 z-50 w-[90%] max-w-md bg-green-500 text-white px-4 py-3 rounded shadow flex justify-between items-center mb-4" id="flash-container">
      <span><%= success_msg %></span>
      <button onclick="this.parentElement.remove()" class="text-white font-bold">&times;</button>
  </div>
<% } %>

<% if (typeof error_msg !== 'undefined' && error_msg.length > 0) { %>
  <div class="fixed top-4 left-1/2 transform -translate-x-1/2 z-50 w-[90%] max-w-md bg-red-500 text-white px-4 py-3 rounded shadow flex justify-between items-center mb-4" id="flash-container">
    <span><%= error_msg %></span>
    <button onclick="this.parentElement.remove()" class="text-white font-bold">&times;</button>
  </div>
<% } %>

<% if (typeof errors !== 'undefined' && errors.length > 0) { %>
  <div class="fixed top-4 left-1/2 transform -translate-x-1/2 z-50 w-[90%] max-w-md bg-red-600 text-white px-4 py-3 rounded shadow mb-4"  id="flash-container">
    <ul class="list-disc pl-5">
      <% errors.forEach(function(error) { %>
        <li><%= error %></li>
      <% }); %>
    </ul>
    <button onclick="this.parentElement.remove()" class="text-white font-bold float-right mt-2">&times;</button>
  </div>
<% } %>
<script>
  setTimeout(() => {
    const flash = document.getElementById('flash-container');
    if (flash) flash.style.display = 'none';
  }, 5000);
</script>
