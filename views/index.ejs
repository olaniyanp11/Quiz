<%- include('./partials/header') %>


  <!-- Hero Section -->
  <section class="relative h-screen bg-cover bg-center pl-8" style="background-image: url('/image/notes.jpg');">
    <!-- Overlay -->
    <div class="absolute inset-0 bg-green-900 bg-opacity-60"></div>

    <div class="relative z-10 flex flex-col justify-center items-start h-full text-center px-4">
      <h1 class="text-4xl sm:text-6xl w-[90%] sm:w-[60%] font-bold text-white mb-3 sm:mb-6 text-left">Test Your Knowledge. Compete. Win.</h1>
      <p class="text-white text-md md:text-xl mb-3 sm:mb-5 max-w-2xl text-left">Join thousands of learners in fun and challenging quizzes. Pick a category, answer questions, and climb the leaderboard.</p>
      <div class="flex space-x-4">
        <a href="/register" class="bg-white text-green-600 px-6 py-3 rounded-lg font-semibold hover:bg-gray-100">Sign Up</a>
        <a href="/login" class="bg-green-500 text-white px-6 py-3 rounded-lg font-semibold hover:bg-green-600">Login</a>
      </div>
    </div>
  </section>
<!-- 2nd Section: Text Left, Image Right -->
<section id="features" class="py-20 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 flex flex-col md:flex-row items-center md:space-x-12">
    <!-- Text -->
    <div class="md:w-1/2 mb-8 md:mb-0">
      <h2 class="text-3xl font-bold text-green-800 mb-4">Pick Your Favorite Category</h2>
      <p class="text-gray-700 mb-6">
        Choose from General Knowledge, Science, Technology, History, Sports, and more. Customize your quiz experience and focus on what interests you most.
      </p>
      <a href="/register" class="bg-green-500 text-white px-6 py-3 rounded-lg font-semibold hover:bg-green-600">Start Now</a>
    </div>
    <!-- Image -->
    <div class="md:w-1/2">
      <img src="/image/people.png" alt="Quiz Categories" class="rounded-lg shadow-lg">
    </div>
  </div>
</section>

<!-- 3rd Section: Central Text -->
<section id="how-it-works" class="py-20 bg-green-50">
  <div class="max-w-3xl mx-auto text-center px-4">
    <h2 class="text-3xl md:text-4xl font-bold text-green-800 mb-6">How It Works</h2>
    <p class="text-gray-700 text-lg mb-8">
      Register or login, pick a category, answer exciting multiple-choice questions under a timer, and earn points! Track your progress and see your ranking on the leaderboard in real-time.
    </p>
<a href="/login" class="bg-green-500 text-white px-6 py-3 rounded-lg font-semibold hover:bg-green-600">
  <i class="fas fa-play mr-2"></i> Try a Quiz
</a>
  </div>
</section>

<!-- 4th Section: 3-column Image + Text -->
<section id="leaderboard" class="py-20 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 text-center mb-12">
    <h2 class="text-3xl md:text-4xl font-bold text-green-800">Leaderboard & Achievements</h2>
    <p class="text-gray-700 mt-4">Compete with thousands of players worldwide and track your achievements!</p>
  </div>
  <div class="max-w-6xl mx-auto px-4 grid grid-cols-1 md:grid-cols-3 gap-12">
    <!-- Card 1 -->
    <div class="bg-white rounded-lg shadow-sm overflow-hidden">
      <img src="/image/grad.jpeg" alt="Leaderboard" class="w-full h-48 object-cover">
      <div class="p-6">
        <h3 class="text-xl font-semibold mb-2 text-green-700"> <i class="fas fa-trophy mr-2"></i> Top Players</h3>
        <p class="text-gray-600">See the top scorers and get motivated to climb the ranks. Weekly and monthly challenges keep it exciting!</p>
      </div>
    </div>
    <!-- Card 2 -->
    <div class="bg-white rounded-lg shadow-sm overflow-hidden">
      <img src="/image/acheive.jpg" alt="Achievements" class="w-full h-48 object-cover">
      <div class="p-6">
        <h3 class="text-xl font-semibold mb-2 text-green-700">  <i class="fas fa-award mr-2"></i> Achievements</h3>
        <p class="text-gray-600">Unlock badges and awards as you improve your scores. Show off your achievements to friends.</p>
      </div>
    </div>
    <!-- Card 3 -->
    <div class="bg-white rounded-lg shadow-sm overflow-hidden">
      <img src="/image/Misk.jpg" alt="Challenges" class="w-full h-48 object-cover">
      <div class="p-6">
        <h3 class="text-xl font-semibold mb-2 text-green-700"><i class="fas fa-bolt mr-2"></i> Challenges</h3>
        <p class="text-gray-600">Participate in special events and weekly challenges to win bonus points and exclusive badges.</p>
      </div>
    </div>
  </div>
</section>

  <!-- Script for mobile menu toggle -->
  <script>
    const btn = document.getElementById('menu-btn');
    const menu = document.getElementById('mobile-menu');

    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  </script>

<%- include('./partials/footer') %>